# ---------------------------------------------------------------------------
# Dart / Flutter - artefatos gerados (não versionar)
# ---------------------------------------------------------------------------
.dart_tool/
.packages
.pub/
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
build/
coverage/
**/doc/api/

# ---------------------------------------------------------------------------
# Símbolos e mapas de build
# ---------------------------------------------------------------------------
app.*.symbols
app.*.map.json

# ---------------------------------------------------------------------------
# Android (quando a plataforma for adicionada)
# ---------------------------------------------------------------------------
android/app/debug
android/app/profile
android/app/release
android/.gradle/
android/local.properties
android/key.properties
*.jks
*.keystore

# ---------------------------------------------------------------------------
# iOS / macOS (quando a plataforma for adicionada)
# ---------------------------------------------------------------------------
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/macos/Flutter/ephemeral/

# ---------------------------------------------------------------------------
# Windows / Linux (quando a plataforma for adicionada)
# ---------------------------------------------------------------------------
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
